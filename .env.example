# Neon Postgres — provisioned via Vercel Marketplace
DATABASE_URL=postgres://user:pass@ep-xxxx.us-east-1.aws.neon.tech/crumbl?sslmode=require

# Public site URL (used for OG image / tweet links)
NEXT_PUBLIC_SITE_URL=https://crumbltracker.app

# Vercel cron shared secret (leave blank locally; Vercel injects x-vercel-cron)
CRON_SECRET=

# Twitter / X API v2 (leave blank until you have credentials — bot runs dry)
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_DRY_RUN=1
